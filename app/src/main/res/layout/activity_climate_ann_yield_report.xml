<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/logo_1"
    android:orientation="vertical"
    tools:context=".ClimateAnnYieldReportActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/climate_ann_title_hindi"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:text="@string/climate_ann_title"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <ProgressBar
        android:id="@+id/climateAnnProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/climate_ann_range_label"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/climateAnnRangeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/climateAnnRangeCrop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/climate_ann_range_crop" />

                <RadioButton
                    android:id="@+id/climateAnnRangeWind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/climate_ann_range_wind" />

                <RadioButton
                    android:id="@+id/climateAnnRangeSowHarvest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/climate_ann_range_sow_harvest" />
            </RadioGroup>

            <TextView
                android:id="@+id/climateAnnSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:text="@string/climate_ann_loading"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/climate_ann_predictors_title"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/climateAnnPredictorsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/climateAnnArchitectureText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/climate_ann_architecture"
                android:textColor="@color/crop_season_green"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/climate_ann_result_title"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/climateAnnYieldText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/climateAnnMetricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/climateAnnTrainingNoteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/climate_ann_chart_rainfall"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/climateAnnRainfallChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/climate_ann_chart_temperature"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/climateAnnTemperatureChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/climateAnnContinueBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:enabled="false"
        android:text="@string/climate_ann_continue" />
</LinearLayout>
