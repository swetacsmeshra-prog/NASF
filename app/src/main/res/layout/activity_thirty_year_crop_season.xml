<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/logo_1"
    android:orientation="vertical"
    tools:context=".ThirtyYearCropSeasonActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/thirty_year_title_hindi"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:text="@string/thirty_year_title"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/thirtyYearYearDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:hint="@string/thirty_year_select_year">

        <AutoCompleteTextView
            android:id="@+id/thirtyYearYearDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/thirtyYearDataSourceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:textColor="@color/crop_season_green"
        android:textSize="12sp"
        tools:text="Charts: segregated CSV (440 farms)" />

    <ProgressBar
        android:id="@+id/thirtyYearProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/thirtyYearScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/thirtyYearSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_background"
                android:padding="10dp"
                android:text="@string/thirty_year_loading"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/thirty_year_chart_historical_rain"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/thirtyYearHistoricalRainChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/thirty_year_chart_historical_temp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearHistoricalTempChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/thirty_year_chart_yield_trend"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearYieldTrendChart"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/thirtyYearYearDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                tools:text="2015 Crop Season (weeks 23–44)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thirty_year_chart_rainfall"
                android:textColor="@color/dark_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/thirtyYearRainfallChart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thirty_year_chart_temperature"
                android:textColor="@color/dark_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearTemperatureChart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thirty_year_chart_humidity"
                android:textColor="@color/dark_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearHumidityChart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thirty_year_chart_solar"
                android:textColor="@color/dark_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearSolarChart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/thirty_year_chart_wind"
                android:textColor="@color/dark_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/thirtyYearWindChart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/thirtyYearRfTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                tools:text="Random Forest — 2018" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/thirtyYearRfYieldText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/thirtyYearModelInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/thirtyYearImportanceChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/thirtyYearCubicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                tools:text="Cubic Model — 2018" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/thirtyYearCubicYieldText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/thirtyYearSeasonRainText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <com.github.mikephil.charting.charts.CombinedChart
                    android:id="@+id/thirtyYearCubicChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/thirtyYearDownloadCsvBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/thirty_year_download_csv" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
