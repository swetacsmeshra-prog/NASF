<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/logo_1"
    android:orientation="vertical"
    tools:context=".ManualClimateYieldFormActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/manual_climate_title_hindi"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:text="@string/manual_climate_title"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/login_text1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/manual_climate_subtitle"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/climatology_lat_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateLat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/climatology_lon_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateLon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/climatologyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/dark_blue"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/manualClimateFillTypicalBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/climatology_fill_typical" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateRainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/manual_climate_rain_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateRain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateTminLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/manual_climate_tmin_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateTmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateTmaxLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/manual_climate_tmax_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateTmax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateWindLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/manual_climate_wind_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateWind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateSolarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/manual_climate_solar_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateSolar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/manualClimateHumidityLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/manual_climate_humidity_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/manualClimateHumidity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                        android:textColor="@color/dark_blue"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/manualClimateCalculateBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/manual_climate_calculate" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/manual_climate_result_title"
                android:textColor="@color/dark_blue"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manualClimateYieldText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manualClimateYieldChangeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/crop_season_green"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/manualClimateInputsUsedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/manualClimateZScoreText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dark_blue"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/manualClimateMetricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/card_background"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/manualClimateTrainingNoteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
